{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://qurannotes.app/contracts/noor-rag-v1.schema.json",
    "title": "QuranNotes Noor RAG v1 wire contract",
    "$defs": {
        "NoorSource": {
            "type": "string",
            "enum": [
                "ibn_kathir_en_abridged",
                "al_sadi_ar"
            ]
        },
        "NoorHistoryRole": {
            "type": "string",
            "enum": [
                "user",
                "assistant"
            ]
        },
        "RequestId": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        },
        "Question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
        },
        "QuranSurah": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
        },
        "QuranVerse": {
            "type": "integer",
            "minimum": 1,
            "x-quranVerseBounds": "Validated against the deterministic 114-surah verse-count table"
        },
        "NoorHistoryTurn": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "role",
                "content"
            ],
            "properties": {
                "role": {
                    "$ref": "#/$defs/NoorHistoryRole"
                },
                "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                }
            }
        },
        "NoorVerseContext": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "surah",
                "verse"
            ],
            "properties": {
                "surah": {
                    "$ref": "#/$defs/QuranSurah"
                },
                "verse": {
                    "$ref": "#/$defs/QuranVerse"
                }
            }
        },
        "NoorChatRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "requestId",
                "question",
                "history"
            ],
            "properties": {
                "mode": {
                    "const": "chat"
                },
                "requestId": {
                    "$ref": "#/$defs/RequestId"
                },
                "question": {
                    "$ref": "#/$defs/Question"
                },
                "history": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                        "$ref": "#/$defs/NoorHistoryTurn"
                    },
                    "x-maxTotalContentLength": 6000
                },
                "verseContext": {
                    "$ref": "#/$defs/NoorVerseContext"
                }
            }
        },
        "NoorVerseSummaryRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "requestId",
                "source",
                "surah",
                "verse"
            ],
            "properties": {
                "mode": {
                    "const": "verse_summary"
                },
                "requestId": {
                    "$ref": "#/$defs/RequestId"
                },
                "source": {
                    "$ref": "#/$defs/NoorSource"
                },
                "surah": {
                    "$ref": "#/$defs/QuranSurah"
                },
                "verse": {
                    "$ref": "#/$defs/QuranVerse"
                }
            }
        },
        "NoorVerseQuestionRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "requestId",
                "source",
                "surah",
                "verse",
                "question"
            ],
            "properties": {
                "mode": {
                    "const": "verse_question"
                },
                "requestId": {
                    "$ref": "#/$defs/RequestId"
                },
                "source": {
                    "$ref": "#/$defs/NoorSource"
                },
                "surah": {
                    "$ref": "#/$defs/QuranSurah"
                },
                "verse": {
                    "$ref": "#/$defs/QuranVerse"
                },
                "question": {
                    "$ref": "#/$defs/Question"
                }
            }
        },
        "NoorRequest": {
            "oneOf": [
                {
                    "$ref": "#/$defs/NoorChatRequest"
                },
                {
                    "$ref": "#/$defs/NoorVerseSummaryRequest"
                },
                {
                    "$ref": "#/$defs/NoorVerseQuestionRequest"
                }
            ]
        },
        "NoorStatus": {
            "type": "string",
            "enum": [
                "answered",
                "insufficient_evidence",
                "policy_refusal",
                "not_entitled",
                "quota_exceeded",
                "invalid_request",
                "temporarily_unavailable"
            ]
        },
        "NoorCitation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "chunkId",
                "canonicalUnitId",
                "source",
                "sourceTitle",
                "surah",
                "verseStart",
                "verseEnd",
                "corpusVersion"
            ],
            "properties": {
                "chunkId": {
                    "type": "string",
                    "minLength": 1
                },
                "canonicalUnitId": {
                    "type": "string",
                    "minLength": 1
                },
                "source": {
                    "$ref": "#/$defs/NoorSource"
                },
                "sourceTitle": {
                    "type": "string",
                    "minLength": 1
                },
                "surah": {
                    "$ref": "#/$defs/QuranSurah"
                },
                "verseStart": {
                    "$ref": "#/$defs/QuranVerse"
                },
                "verseEnd": {
                    "$ref": "#/$defs/QuranVerse"
                },
                "corpusVersion": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "NoorQuotaExceededAnswer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "requestId",
                "answer",
                "status",
                "citations",
                "nextResetAt"
            ],
            "properties": {
                "requestId": {
                    "$ref": "#/$defs/RequestId"
                },
                "answer": {
                    "type": "string"
                },
                "status": {
                    "const": "quota_exceeded"
                },
                "citations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/NoorCitation"
                    }
                },
                "nextResetAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
                }
            }
        },
        "NoorNonQuotaAnswer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "requestId",
                "answer",
                "status",
                "citations"
            ],
            "properties": {
                "requestId": {
                    "$ref": "#/$defs/RequestId"
                },
                "answer": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "answered",
                        "insufficient_evidence",
                        "policy_refusal",
                        "not_entitled",
                        "invalid_request",
                        "temporarily_unavailable"
                    ]
                },
                "citations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/NoorCitation"
                    }
                },
                "nextResetAt": {
                    "not": {}
                }
            }
        },
        "NoorAnswer": {
            "oneOf": [
                {
                    "$ref": "#/$defs/NoorQuotaExceededAnswer"
                },
                {
                    "$ref": "#/$defs/NoorNonQuotaAnswer"
                }
            ]
        }
    },
    "oneOf": [
        {
            "$ref": "#/$defs/NoorRequest"
        },
        {
            "$ref": "#/$defs/NoorAnswer"
        }
    ]
}
