{
    "name": "quran-notes-functions",
    "description": "Firebase Cloud Functions for QuranNotes security hardening",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:test": "tsc -p tsconfig.test.json",
        "build:scripts": "tsc -p tsconfig.scripts.json",
        "test": "npm run build:test && node --test lib-test/test/noor-rag/*.test.js",
        "noor:corpus:build": "npm run build:scripts && node lib-scripts/scripts/noor-rag/build-corpus.js",
        "noor:corpus:validate": "npm run build:scripts && node lib-scripts/scripts/noor-rag/validate-corpus.js",
        "contract:check": "node ../scripts/generate-noor-contract.js --check",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "20"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@google/genai": "^1.29.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^5.0.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.25.2",
        "@types/node": "20.19.43",
        "typescript": "^5.0.0"
    },
    "private": true
}
